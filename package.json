{
  "name": "@agilisdating/ads",
  "version": "0.1.1",
  "description": "The official Node.js and TypeScript library for the Agilis Advertising API",
  "license": "MIT",
  "author": "Agilis Dating Ltd <help@agilis.dating>",
  "homepage": "https://github.com/agilisdating/agilis-ads-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilisdating/agilis-ads-node.git"
  },
  "bugs": {
    "url": "https://github.com/agilisdating/agilis-ads-node/issues"
  },
  "keywords": [
    "agilis",
    "advertising",
    "ads",
    "api",
    "sdk",
    "offers",
    "events",
    "webhooks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "generate": "node scripts/generate-types.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
